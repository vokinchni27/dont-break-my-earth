# Supabase > Project Settings > API
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_publishable_key
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key

# URL canonique du site, sans slash final.
# Tant qu'aucun domaine n'est acheté, c'est l'adresse Vercel.
PUBLIC_SITE_URL=https://dont-break-my-earth.vercel.app

# Secrets aléatoires distincts (openssl rand -hex 32)
RATE_LIMIT_SECRET=replace_with_64_random_hex_characters
UPLOAD_TOKEN_SECRET=replace_with_64_other_random_hex_characters

# Réglages facultatifs
MAX_UPLOAD_BYTES=8388608
SIGNED_URL_TTL_SECONDS=3600
GOOGLE_EARTH_URL=https://earth.google.com/web/
